<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="2dp" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle"><solid android:color="#555555" /></shape>
    </item>
    <item android:id="@android:id/progress" android:height="2dp" android:gravity="center_vertical|fill_horizontal">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle"><solid android:color="#DEDEDE" /></shape>
        </clip>
    </item>
</layer-list>
